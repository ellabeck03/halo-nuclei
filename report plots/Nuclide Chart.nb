 CellLabel->"In[23]:=",ExpressionUUID->"531e0827-cf59-a34a-a8ef-79fb505adb31"],

Cell["\<\
prune the data to remove missing/incomplete entries and match atomic number \
to element\
\>", "Text",
 CellChangeTimes->{{3.972022082125906*^9, 3.9720220920659904`*^9}, {
  3.972022233469204*^9, 
  3.972022239348877*^9}},ExpressionUUID->"26bb9f2c-213a-4e4e-93ea-\
edf2c35055aa"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"elementAssignment", "=", 
    RowBox[{"Union", "[", 
     RowBox[{"DeleteCases", "[", 
      RowBox[{
       RowBox[{"isotopeSelection", "/.", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"z_", ",", " ", "n_", ",", " ", "el_", ",", " ", "e_"}], 
          "}"}], ":>", " ", 
         RowBox[{"Rule", "[", 
          RowBox[{"z", ",", "el"}], "]"}]}]}], ",", " ", 
       RowBox[{"Rule", "[", 
        RowBox[{"a_", ",", " ", 
         RowBox[{"Missing", "[", "\"\<NotAvailable\>\"", "]"}]}], "]"}]}], 
      "]"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"elementAssignment", "=", 
   RowBox[{"elementAssignment", "/.", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"z_", ",", "n_", ",", 
       RowBox[{"Missing", "[", "\"\<NotAvailable\>\"", "]"}], ",", "e_"}], 
      "}"}], ":>", 
     RowBox[{"{", 
      RowBox[{"z", ",", "n", ",", 
       RowBox[{"z", "/.", "rl"}], ",", "e"}], "}"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"finalData", "=", 
    RowBox[{"Association", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Rule", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{"#", "[", "2", "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "3", "]"}], "]"}], ",", 
           RowBox[{"#", "[", 
            RowBox[{"[", "4", "]"}], "]"}]}], "}"}]}], "]"}], "&"}], "/@", 
      "isotopeSelection"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DeleteCases", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Head", "[", 
           RowBox[{"finalData", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "-", "1"}], ",", 
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "]"}], "]"}], "=!=", 
          "Missing"}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"finalData", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "]"}], "[", 
             RowBox[{"[", "2", "]"}], "]"}], "-", 
            RowBox[{
             RowBox[{"finalData", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"#", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "-", "1"}], ",", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "]"}], "[", 
             RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}]}], "]"}], ")"}], "&"}],
      "/@", "isotopeSelection"}], ",", "Null"}], "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.9720222483332787`*^9, 3.97202235520582*^9}, {
  3.972022401476349*^9, 3.9720226495394154`*^9}, {3.972022695718996*^9, 
  3.9720228625542145`*^9}},
 CellLabel->"In[24]:=",ExpressionUUID->"b015e6af-b266-ad4e-b440-7ac0989a6f6c"],

