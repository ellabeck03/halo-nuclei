  3.9720216897657185`*^9}},ExpressionUUID->"98e33489-90c3-cb4d-9197-\
51997c33671f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ToBoxes", "[", 
    RowBox[{
     RowBox[{"\[InvisiblePrefixScriptBase]", "Superscript"}], "[", 
     RowBox[{"b", ",", "a"}], "]"}], "]"}], "//", "InputForm"}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9720217032999783`*^9, 3.9720217334443417`*^9}, {
   3.9720218837896824`*^9, 3.972021982303997*^9}, {3.972022018830307*^9, 
