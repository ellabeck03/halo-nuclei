Notebook[{
Cell["\<\
it seems that mathematica already has an internal list of nuclear data \
yippee!!!!\
\>", "Text",
 CellChangeTimes->{{3.972021026459421*^9, 
  3.9720210456015167`*^9}},ExpressionUUID->"81eebd67-794a-c449-a0a1-\
fd06653cdc6a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"isotopes", " ", "=", " ", 
   RowBox[{"EntityValue", "[", 
    RowBox[{"\"\<Isotope\>\"", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"EntityProperty", "[", 
        RowBox[{"\"\<Isotope\>\"", ",", "\"\<AtomicNumber\>\""}], "]"}], ",", 
       " ", "\n", "\t", 
       RowBox[{"EntityProperty", "[", 
        RowBox[{"\"\<Isotope\>\"", ",", "\"\<NeutronNumber\>\""}], "]"}], ",",
        " ", 
       RowBox[{"EntityProperty", "[", 
        RowBox[{"\"\<Isotope\>\"", ",", "\"\<AtomicSymbol\>\""}], "]"}], ",", 
       "\n", "\t", 
       RowBox[{"EntityProperty", "[", 
        RowBox[{"\"\<Isotope\>\"", ",", "\"\<BindingEnergy\>\""}], "]"}]}], 
      "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9720208059479523`*^9, 3.9720208136308804`*^9}, {
  3.9720208956779194`*^9, 3.972021003166748*^9}, {3.972021320827919*^9, 
  3.9720213328839664`*^9}, {3.9720216508328342`*^9, 3.972021654264015*^9}},
 CellLabel->"In[21]:=",ExpressionUUID->"c65bb53b-a7a3-064c-b450-bbcf93158abc"],

Cell["make a selection of the nuclides we want to see on the chart", "Text",
 CellChangeTimes->{{3.972021189206957*^9, 
  3.972021198231306*^9}},ExpressionUUID->"3f8467e9-df1b-9445-8f44-\
0ff2ebb1167a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"isotopeSelection", " ", "=", " ", 
   RowBox[{"Select", "[", 
    RowBox[{"isotopes", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"0", "<=", 
        RowBox[{"#", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "<=", "20"}], "\[And]", 
       RowBox[{"0", "<", 
        RowBox[{"#", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "<", "52"}]}], "&"}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9720212060113106`*^9, 3.9720212761903477`*^9}, {
   3.972021362730587*^9, 3.972021392632393*^9}, {3.972021427258131*^9, 
   3.972021430417885*^9}, {3.9720215980837994`*^9, 3.9720216222862453`*^9}, 
   3.9720216576585064`*^9, {3.97202230335878*^9, 3.9720223059315434`*^9}, {
   3.9720223855498085`*^9, 3.972022389530527*^9}, {3.97202378497365*^9, 
   3.972023786121702*^9}},
 CellLabel->"In[22]:=",ExpressionUUID->"0217b63b-086b-3340-9899-27e5e132aa2c"],

