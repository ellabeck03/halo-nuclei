Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"nuclideChart", "=", 
    RowBox[{
     RowBox[{"DisplayForm", "[", 
      RowBox[{"RowBox", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<\\\"\\\\!\\\\(\\\\*SuperscriptBox[\\\\(\\\\), \\\\(\>\"",
          "<>", 
         RowBox[{"ToString", "[", 
          RowBox[{"#1", "+", "#2"}], "]"}], "<>", "\"\<\\\\)]\\\\)\>\"", "<>", 
         RowBox[{"ToString", "[", "#3", "]"}], "<>", "\"\<\\\"\>\""}], "}"}], 
       "]"}], "]"}], "&"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"maxBE", "=", 
   RowBox[{"Max", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"#", "[", 
        RowBox[{"[", "4", "]"}], "]"}], "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "+", 
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ")"}]}], "&"}], "/@", 
     "isotopeSelection"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"color", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"ColorData", "[", "\"\<CandyColors\>\"", "]"}], "[", 
     RowBox[{"#", "*", 
      RowBox[{"0.9", "/", "maxBE"}]}], "]"}], "&"}]}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"color", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"ColorData", "[", "\"\<Pastel\>\"", "]"}], "[", 
      RowBox[{"#", "*", 
       RowBox[{"0.9", "/", "maxBE"}]}], "]"}], "&"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"ColorData", "[", "\"\<Pastel\>\"", "]"}], 
   "*)"}]}], "\[IndentingNewLine]"}], "Input",
